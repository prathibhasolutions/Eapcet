          "key": "word",
          "title": "MS Word",
          "marks": 24,
          "questions": [
            {
              "id": "word-1",
              "marks": 5,
              "text": "Create a Word document and apply underlining with a custom underline color to a selected heading and one sentence in a paragraph."
            },
            {
              "id": "word-2",
              "marks": 5,
              "text": "Insert a bulleted list with at least five points and place Heading 1, Heading 2, and Heading 3 appropriately between paragraphs."
            },
            {
              "id": "word-3",
              "marks": 5,
              "text": "Use Find and Replace to replace one repeated word throughout the document, then insert a 5-column and 8-row table and insert one online picture."
            },
            {
              "id": "word-4",
              "marks": 5,
              "text": "Insert one picture or symbol between text, add a hyperlink to either that picture or a file located on the Desktop, and demonstrate wrapping style adjustment."
            },
            {
              "id": "word-5",
              "marks": 5,
              "text": "Add bookmarks for headings and insert cross-references to those headings in another part of the document."
            },
            {
              "id": "word-6",
              "marks": 5,
              "text": "Apply a watermark, change the page color, add a page border, and format any paragraph into three newspaper-style columns."
            },
            {
              "id": "word-7",
              "marks": 5,
              "text": "Insert a table of contents for all headings, add at least one footnote per page, insert one book citation, and add image captions."
            },
            {
              "id": "word-8",
              "marks": 5,
              "text": "Create a mail merge recipient list with sample names and details, enable Track Changes and edit text, record one macro, group two objects, remove image background, edit shape points, and write text inside a shape using the same color as the shape."
            }
          ]
        },
        {
